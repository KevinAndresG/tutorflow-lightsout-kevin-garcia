# Copia este archivo a .env y completa LLM_API_KEY. Nunca subas .env al repositorio.

# Llave del proveedor del modelo (obligatoria para preguntar).
LLM_API_KEY=
# openai (por defecto; sirve para Gemini, Groq, OpenAI, Ollama) o anthropic.
LLM_PROVIDER=openai
# Endpoint del proveedor. Vacio = el de por defecto del proveedor.
LLM_BASE_URL=
# Modelo a usar. Vacio = el de por defecto.
LLM_MODEL=
# Precio en USD por millon de tokens (para calcular costoUsd).
LLM_PRECIO_ENTRADA_MTOK=0
LLM_PRECIO_SALIDA_MTOK=0
